{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "^\\.github/workflows/lint\\.yml$"
      ],
      "matchStrings": [
        "uses: golangci/golangci-lint-action@\\S+\\s+with:\\s+version: (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    }
  ],
  "schedule": [
    "before 9am on monday"
  ],
  "labels": [
    "dependencies",
    "ci"
  ],
  "commitMessagePrefix": "chore(ci):"
}
